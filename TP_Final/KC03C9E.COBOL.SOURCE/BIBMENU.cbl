000300*****************************************************************
000310 PROCEDURE DIVISION.
000320 MAIN-ENTRY.
000330     IF EIBCALEN = 0
000340         PERFORM ENVIAR-MENU-INICIAL
000350         EXEC CICS RETURN
000360         END-EXEC
000370     ELSE
000380         PERFORM RECIBIR-OPCION
000390         PERFORM PROCESAR-OPCION
000400     END-IF
000410*
000420     EXEC CICS RETURN
000430     END-EXEC.
000440*****************************************************************
000450 ENVIAR-MENU-INICIAL.
000460     MOVE SPACES        TO WS-MENSAJE
000470     MOVE SPACES        TO BIBMAIN-MSGTXT
000480     MOVE ' '           TO BIBMAIN-OPT
000490     EXEC CICS SEND MAP('BIBMAIN')
000500                    MAPSET('BIBMENU')
000510                    ERASE
000520     END-EXEC.
000530     EXIT.
000540*****************************************************************
000550 RECIBIR-OPCION.
000560     EXEC CICS RECEIVE MAP('BIBMAIN')
000570                      MAPSET('BIBMENU')
000580     END-EXEC
000590*
000600     MOVE BIBMAIN-OPT  TO WS-OPCION
000610     EXIT.
000620*****************************************************************
000630 PROCESAR-OPCION.
000640     MOVE SPACES TO WS-MENSAJE
000650*
000660     EVALUATE FUNCTION TRIM(WS-OPCION)
000670        WHEN '1'
000680           PERFORM ENVIAR-JOB-CARGINI
000690           MOVE 'JOB CARGINI ENVIADO A EJECUCION.' 
000700                TO WS-MENSAJE
000710        WHEN '9'
000720           EXEC CICS RETURN
000730           END-EXEC
000740        WHEN 'X'
000750           EXEC CICS RETURN
000760           END-EXEC
000770        WHEN OTHER
000780           MOVE 'OPCION INVALIDA. INGRESE 1 O 9.' 
000790                TO WS-MENSAJE
000800     END-EVALUATE
000810*
000820     MOVE WS-MENSAJE   TO BIBMAIN-MSGTXT
000830     MOVE SPACES       TO BIBMAIN-OPT
000840*
000850     EXEC CICS SEND MAP('BIBMAIN')
000860                    MAPSET('BIBMENU')
000870                    ERASE
000880     END-EXEC.
000890     EXIT.
000900*****************************************************************
000910 ENVIAR-JOB-CARGINI.
000920* ENVIA EL JOB REAL AL INTERNAL READER (INTRDR)
000930* PARA EJECUTAR EL PROGRAMA BATCH CARGINI.
000940*
000950* LINEA 1: IDENTIFICACION DEL JOB
000960     MOVE '//CARGINI JOB (ACCT),''DESDE CICS'',CLASS=A,MSGCLASS=X' 
000970          TO WS-LINEA-JCL
000980     EXEC CICS WRITEQ TD QUEUE('INTRDR')
000990          FROM(WS-LINEA-JCL)
001000          LENGTH(WS-LEN)
001010     END-EXEC
001020*
001030* LINEA 2: PASO DE EJECUCION DEL PROGRAMA
001040     MOVE '//STEP1 EXEC PGM=CARGINI' TO WS-LINEA-JCL
001050     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001060          FROM(WS-LINEA-JCL)
001070          LENGTH(WS-LEN)
001080     END-EXEC
001090*
001100* LINEA 3: STEPLIB
001110     MOVE '//STEPLIB DD DSN=KC03C9E.LOAD.LIBRARY,DISP=SHR'
001120          TO WS-LINEA-JCL
001130     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001140          FROM(WS-LINEA-JCL)
001150          LENGTH(WS-LEN)
001160     END-EXEC
001170*
001180* LINEA 4: DDIN - ARCHIVO DE ENTRADA
001190     MOVE '//DDIN DD DSN=KC03C9E.DATA.INPUT,DISP=SHR'
001200          TO WS-LINEA-JCL
001210     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001220          FROM(WS-LINEA-JCL)
001230          LENGTH(WS-LEN)
001240     END-EXEC
001250*
001260* LINEA 5: DDOUT - MAESTRO DE LIBROS
001270     MOVE '//DDOUT DD DSN=KC03C9E.DATA.LIBROS,DISP=SHR'
001280          TO WS-LINEA-JCL
001290     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001300          FROM(WS-LINEA-JCL)
001310          LENGTH(WS-LEN)
001320     END-EXEC
001330*
001340* LINEA 6: DDREP - REPORTE DE SALIDA
001350     MOVE '//DDREP DD DSN=KC03C9E.REPORTES.OUTPUT,DISP=MOD'
001360          TO WS-LINEA-JCL
001370     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001380          FROM(WS-LINEA-JCL)
001390          LENGTH(WS-LEN)
001400     END-EXEC
001410*
001420* LINEA 7: SYSOUT
001430     MOVE '//SYSOUT DD SYSOUT=*' TO WS-LINEA-JCL
001440     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001450          FROM(WS-LINEA-JCL)
001460          LENGTH(WS-LEN)
001470     END-EXEC
001480*
001490* LINEA 8: SYSIN DUMMY
001500     MOVE '//SYSIN DD DUMMY' TO WS-LINEA-JCL
001510     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001520          FROM(WS-LINEA-JCL)
001530          LENGTH(WS-LEN)
001540     END-EXEC
001550*
001560* LINEA 9: FIN DE JOB
001570     MOVE '//*' TO WS-LINEA-JCL
001580     EXEC CICS WRITEQ TD QUEUE('INTRDR')
001590          FROM(WS-LINEA-JCL)
001600          LENGTH(WS-LEN)
001610     END-EXEC.
