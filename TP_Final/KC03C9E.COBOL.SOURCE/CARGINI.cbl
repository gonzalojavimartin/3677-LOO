000010*****************************************************************
000020* PROGRAMA : CARGINI                                           *
000030* PROPOSITO: CARGA INICIAL DEL MAESTRO DE LIBROS               *
000040*            DESDE ARCHIVO DE ENTRADA SECUENCIAL               *
000050* AUTOR    : KC03C9E                                           *
000060* FECHA    : 09/11/2025                                        *
000070* VERSION  : 1.1                                               *
000080*****************************************************************
000090* DESCRIPCION GENERAL:                                         *
000100* - LEE ARCHIVO DE ENTRADA  (DDNAME DDIN).                     *
000110* - VALIDA CAMPOS MINIMOS DEL REGISTRO.                        *
000120* - GENERA MAESTRO LIBROS     (DDNAME DDOUT).                  *
000130* - EMITE REPORTE DE CARGA    (DDNAME DDREP).                  *
000140* - UTILIZA COPYBOOKS: LIBRO, CONSTANT, MENSAJES, LINREP.      *
000150*****************************************************************
000160 IDENTIFICATION DIVISION.
000170 PROGRAM-ID. CARGINI.
000180*****************************************************************
000190 ENVIRONMENT DIVISION.
000200 INPUT-OUTPUT SECTION.
000210 FILE-CONTROL.
000220     SELECT ARCH-INPUT
000230         ASSIGN TO DDIN
000240         ORGANIZATION IS SEQUENTIAL
000250         ACCESS MODE  IS SEQUENTIAL
000260         FILE STATUS  IS WS-STAT-INPUT.
000270     SELECT ARCH-LIBROS
000280         ASSIGN TO DDOUT
000290         ORGANIZATION IS SEQUENTIAL
000300         ACCESS MODE  IS SEQUENTIAL
000310         FILE STATUS  IS WS-STAT-LIBROS.
000320     SELECT ARCH-REP
000330         ASSIGN TO DDREP
000340         ORGANIZATION IS SEQUENTIAL
000350         ACCESS MODE  IS SEQUENTIAL
000360         FILE STATUS  IS WS-STAT-REP.
000370*****************************************************************
000380 DATA DIVISION.
000390 FILE SECTION.
000400*
000410 FD  ARCH-INPUT
000420     RECORD CONTAINS 200 CHARACTERS
000430     BLOCK CONTAINS 0 RECORDS
000440     RECORDING MODE IS F.
000450 01 REG-INPUT                 PIC X(200).
000460*
000470 FD  ARCH-LIBROS
000480     RECORD CONTAINS 250 CHARACTERS
000490     BLOCK CONTAINS 0 RECORDS
000500     RECORDING MODE IS F.
000510     COPY LIBRO.
000520*
000530 FD  ARCH-REP
000540     RECORD CONTAINS 133 CHARACTERS
000550     BLOCK CONTAINS 0 RECORDS
000560     RECORDING MODE IS F.
000570 01 REG-REP                   PIC X(133).
000580*****************************************************************
000590 WORKING-STORAGE SECTION.
000600*****************************************************************
000610* COPYBOOKS DE SOPORTE                                         *
000620*****************************************************************
000630     COPY CONSTANT.
000640     COPY MENSAJES.
000650     COPY LINREP.
000660*****************************************************************
000670* VARIABLES DE CONTROL                                         *
000680*****************************************************************
000690 01 WS-STATUS.
000700    05 WS-STAT-INPUT         PIC XX VALUE '00'.
000710    05 WS-STAT-LIBROS        PIC XX VALUE '00'.
000720    05 WS-STAT-REP           PIC XX VALUE '00'.
000730*
000740 01 WS-FLAGS.
000750    05 WS-FIN                PIC X  VALUE 'N'.
000760       88 FIN-ARCHIVO               VALUE 'S'.
000770    05 WS-VALID-FLAG         PIC X  VALUE 'S'.
000780       88 VALID-OK                  VALUE 'S'.
000790       88 VALID-NOK                 VALUE 'N'.
000800*
000810 01 WS-CONTADORES.
000820    05 WS-LEIDOS             PIC 9(7) VALUE 0.
000830    05 WS-OK                 PIC 9(7) VALUE 0.
000840    05 WS-ERR                PIC 9(7) VALUE 0.
000850*****************************************************************
000860* CAMPOS PARSEADOS DESDE REG-INPUT                             *
000870*****************************************************************
000880 01 WS-INPUT-FIELDS.
000890    05 IN-CODIGO             PIC X(10).
000900    05 IN-TITULO             PIC X(60).
000910    05 IN-AUTOR              PIC X(40).
000920    05 IN-EDITORIAL          PIC X(30).
000930    05 IN-CATEGORIA          PIC X(20).
000940    05 IN-STOCK              PIC X(3).
000950    05 IN-UBICACION          PIC X(10).
000960*****************************************************************
000970 PROCEDURE DIVISION.
000980*****************************************************************
000990 MAIN-SECTION.
001000     PERFORM INICIALIZAR
001010     PERFORM PROCESAR
001020     PERFORM FINALIZAR
001030     GOBACK.
001040*****************************************************************
001050 INICIALIZAR.
001060     OPEN INPUT  ARCH-INPUT
001070          OUTPUT ARCH-LIBROS
001080          OUTPUT ARCH-REP
001090*
001100     IF WS-STAT-INPUT NOT = "00"
001110        MOVE "ERROR APERTURA ARCH-INPUT: " TO REG-REP(1:27)
001120        MOVE WS-STAT-INPUT                TO REG-REP(28:2)
001130        WRITE REG-REP
001140        GO TO FINALIZAR
001150     END-IF
001160*
001170     IF WS-STAT-LIBROS NOT = "00"
001180        MOVE "ERROR APERTURA ARCH-LIBROS: " TO REG-REP(1:28)
001190        MOVE WS-STAT-LIBROS               TO REG-REP(29:2)
001200        WRITE REG-REP
001210        GO TO FINALIZAR
001220     END-IF
001230*
001240     IF WS-STAT-REP NOT = "00"
001250        DISPLAY "ERROR APERTURA ARCH-REP: " WS-STAT-REP
001260        GO TO FINALIZAR
001270     END-IF
001280*
001290     MOVE LINEA-CABECERA TO REG-REP
001300     WRITE REG-REP.
001310*****************************************************************
001320 PROCESAR.
001330     PERFORM LEER-REGISTRO
001340     PERFORM UNTIL FIN-ARCHIVO
001350        ADD 1 TO WS-LEIDOS
001360        PERFORM PARSEAR-REGISTRO
001370        PERFORM VALIDAR-REGISTRO
001380        IF VALID-OK
001390           PERFORM GRABAR-LIBRO
001400           PERFORM GRABAR-DETALLE-OK
001410        ELSE
001420           PERFORM GRABAR-DETALLE-ERROR
001430        END-IF
001440        PERFORM LEER-REGISTRO
001450     END-PERFORM.
001460*****************************************************************
001470 LEER-REGISTRO.
001480     READ ARCH-INPUT
001490         AT END
001500            MOVE 'S' TO WS-FIN
001510     END-READ.
001520*****************************************************************
001530 PARSEAR-REGISTRO.
001540* FORMATO DE ENTRADA (LRECL=200):
001550* 1-10   CODIGO
001560* 11-70  TITULO (60)
001570* 71-110 AUTOR (40)
001580* 111-140 EDITORIAL (30)
001590* 141-160 CATEGORIA (20)
001600* 161-163 STOCK (3)
001610* 164-173 UBICACION (10)
001620*****************************************************************
001630     MOVE REG-INPUT(1:10)    TO IN-CODIGO
001640     MOVE REG-INPUT(11:60)   TO IN-TITULO
001650     MOVE REG-INPUT(71:40)   TO IN-AUTOR
001660     MOVE REG-INPUT(111:30)  TO IN-EDITORIAL
001670     MOVE REG-INPUT(141:20)  TO IN-CATEGORIA
001680     MOVE REG-INPUT(161:3)   TO IN-STOCK
001690     MOVE REG-INPUT(164:10)  TO IN-UBICACION.
001700*****************************************************************
001710 VALIDAR-REGISTRO.
001720     SET VALID-OK TO TRUE
001730*
001740     IF IN-CODIGO = SPACES
001750        SET VALID-NOK TO TRUE
001760     END-IF
001770*
001780     IF IN-TITULO = SPACES
001790        SET VALID-NOK TO TRUE
001800     END-IF
001810*
001820     IF IN-STOCK = SPACES OR
001830        IN-STOCK IS NOT NUMERIC
001840        SET VALID-NOK TO TRUE
001850     END-IF.
001860*****************************************************************
001870 GRABAR-LIBRO.
001880     MOVE IN-CODIGO       TO LIB-CODIGO
001890     MOVE IN-TITULO       TO LIB-TITULO
001900     MOVE IN-AUTOR        TO LIB-AUTOR
001910     MOVE IN-EDITORIAL    TO LIB-EDITORIAL
001920     MOVE IN-CATEGORIA    TO LIB-CATEGORIA
001930     MOVE IN-STOCK        TO LIB-STOCK-TOTAL
001940     MOVE IN-STOCK        TO LIB-STOCK-DISPONIBLE
001950     MOVE IN-UBICACION    TO LIB-UBICACION
001960*
001970     WRITE REG-LIBRO
001980     IF WS-STAT-LIBROS = "00"
001990        ADD 1 TO WS-OK
002000     ELSE
002010        ADD 1 TO WS-ERR
002020     END-IF.
002030*****************************************************************
002040 GRABAR-DETALLE-OK.
002050     MOVE IN-CODIGO     TO LIN-CODIGO
002060     MOVE IN-TITULO     TO LIN-TITULO
002070     MOVE "OK"          TO LIN-RESULTADO
002080     MOVE LINEA-DETALLE TO REG-REP
002090     WRITE REG-REP.
002100*****************************************************************
002110 GRABAR-DETALLE-ERROR.
002120     ADD 1 TO WS-ERR
002130     MOVE IN-CODIGO     TO LIN-CODIGO
002140     MOVE IN-TITULO     TO LIN-TITULO
002150     MOVE "ERROR"       TO LIN-RESULTADO
002160     MOVE LINEA-DETALLE TO REG-REP
002170     WRITE REG-REP.
002180*****************************************************************
002190 FINALIZAR.
002200     MOVE SPACES               TO REG-REP
002210     WRITE REG-REP
002220*
002230     MOVE "TOTAL LEIDOS    : " TO REG-REP(1:19)
002240     MOVE WS-LEIDOS           TO REG-REP(21:7)
002250     WRITE REG-REP
002260*
002270     MOVE "TOTAL OK        : " TO REG-REP(1:19)
002280     MOVE WS-OK               TO REG-REP(21:7)
002290     WRITE REG-REP
002300*
002310     MOVE "TOTAL CON ERROR : " TO REG-REP(1:19)
002320     MOVE WS-ERR              TO REG-REP(21:7)
002330     WRITE REG-REP
002340*
002350     CLOSE ARCH-INPUT ARCH-LIBROS ARCH-REP.
