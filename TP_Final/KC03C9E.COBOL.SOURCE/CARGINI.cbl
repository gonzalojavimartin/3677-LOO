000010*****************************************************************
000020* PROGRAMA : CARGINI                                           *
000030* PROPOSITO: CARGA INICIAL DEL MAESTRO DE LIBROS               *
000040*            DESDE ARCHIVO DE ENTRADA SECUENCIAL               *
000050* AUTOR    : KC03C9E                                           *
000060* FECHA    : 10/11/2025                                        *
000070* VERSION  : 1.3                                               *
000080*****************************************************************
000090* DESCRIPCION GENERAL:                                         *
000100* - LEE ARCHIVO DE ENTRADA  (DDNAME DDIN).                     *
000110* - VALIDA CAMPOS MINIMOS DEL REGISTRO.                        *
000120* - VERIFICA CODIGO UNICO POR LIBRO (SIN DUPLICADOS).          *
000130* - GENERA MAESTRO LIBROS     (DDNAME DDOUT).                  *
000140* - EMITE REPORTE DE CARGA    (DDNAME DDREP).                  *
000150* - UTILIZA COPYBOOKS: LIBRO, CONSTANT, MENSAJES, LINREP.      *
000160*****************************************************************
000170 IDENTIFICATION DIVISION.
000180 PROGRAM-ID. CARGINI.
000190*****************************************************************
000200 ENVIRONMENT DIVISION.
000210 INPUT-OUTPUT SECTION.
000220 FILE-CONTROL.
000230     SELECT ARCH-INPUT
000240         ASSIGN TO DDIN
000250         ORGANIZATION IS SEQUENTIAL
000260         ACCESS MODE  IS SEQUENTIAL
000270         FILE STATUS  IS WS-STAT-INPUT.
000280     SELECT ARCH-LIBROS
000290         ASSIGN TO DDOUT
000300         ORGANIZATION IS SEQUENTIAL
000310         ACCESS MODE  IS SEQUENTIAL
000320         FILE STATUS  IS WS-STAT-LIBROS.
000330     SELECT ARCH-REP
000340         ASSIGN TO DDREP
000350         ORGANIZATION IS SEQUENTIAL
000360         ACCESS MODE  IS SEQUENTIAL
000370         FILE STATUS  IS WS-STAT-REP.
000380*****************************************************************
000390 DATA DIVISION.
000400 FILE SECTION.
000410*
000420 FD  ARCH-INPUT
000430     RECORD CONTAINS 200 CHARACTERS
000440     BLOCK CONTAINS 0 RECORDS
000450     RECORDING MODE IS F.
000460 01 REG-INPUT                 PIC X(200).
000470*
000480 FD  ARCH-LIBROS
000490     RECORD CONTAINS 250 CHARACTERS
000500     BLOCK CONTAINS 0 RECORDS
000510     RECORDING MODE IS F.
000520     COPY LIBRO.
000530*
000540 FD  ARCH-REP
000550     RECORD CONTAINS 133 CHARACTERS
000560     BLOCK CONTAINS 0 RECORDS
000570     RECORDING MODE IS F.
000580 01 REG-REP                   PIC X(133).
000590*****************************************************************
000600 WORKING-STORAGE SECTION.
000610*****************************************************************
000620* COPYBOOKS DE SOPORTE                                         *
000630*****************************************************************
000640     COPY CONSTANT.
000650     COPY MENSAJES.
000660     COPY LINREP.
000670*****************************************************************
000680* VARIABLES DE CONTROL                                         *
000690*****************************************************************
000700 01 WS-STATUS.
000710    05 WS-STAT-INPUT         PIC XX VALUE '00'.
000720    05 WS-STAT-LIBROS        PIC XX VALUE '00'.
000730    05 WS-STAT-REP           PIC XX VALUE '00'.
000740*
000750 01 WS-FLAGS.
000760    05 WS-FIN                PIC X  VALUE 'N'.
000770       88 FIN-ARCHIVO               VALUE 'S'.
000780    05 WS-VALID-FLAG         PIC X  VALUE 'S'.
000790       88 VALID-OK                  VALUE 'S'.
000800       88 VALID-NOK                 VALUE 'N'.
000810    05 WS-DUP-FLAG           PIC X  VALUE 'N'.
000820       88 CODIGO-DUPLICADO          VALUE 'S'.
000830*****************************************************************
000840* CONTADORES                                                   *
000850*****************************************************************
000860 01 WS-CONTADORES.
000870    05 WS-LEIDOS             PIC 9(7) VALUE 0.
000880    05 WS-OK                 PIC 9(7) VALUE 0.
000890    05 WS-ERR                PIC 9(7) VALUE 0.
000900*****************************************************************
000910* CAMPOS PARSEADOS DESDE REG-INPUT                             *
000920*****************************************************************
000930 01 WS-INPUT-FIELDS.
000940    05 IN-CODIGO             PIC X(10).
000950    05 IN-TITULO             PIC X(60).
000960    05 IN-AUTOR              PIC X(40).
000970    05 IN-EDITORIAL          PIC X(30).
000980    05 IN-CATEGORIA          PIC X(20).
000990    05 IN-STOCK              PIC 9(3).
001000    05 IN-UBICACION          PIC X(10).
001010*****************************************************************
001020* TABLA DE CODIGOS PARA CONTROL DE DUPLICADOS                  *
001030* (LIMITE 500 REGISTROS PARA TP; AJUSTABLE SI ES NECESARIO)    *
001040*****************************************************************
001050 01 WS-TABLA-CODIGOS.
001060    05 WS-CODIGO-EXISTENTE   OCCURS 500 TIMES
001070                               PIC X(10).
001080 01 WS-COD-COUNT             PIC 9(4) VALUE 0.
001090 01 WS-INDEX                 PIC 9(4) VALUE 0.
001100*****************************************************************
001110* VARIABLES PARA MOSTRAR TOTALES FORMATEADOS                   *
001120*****************************************************************
001130 01 WS-DISP-TOTALES.
001140    05 WS-DISP-LEIDOS        PIC Z(6)9.
001150    05 WS-DISP-OK            PIC Z(6)9.
001160    05 WS-DISP-ERR           PIC Z(6)9.
001170*****************************************************************
001180 PROCEDURE DIVISION.
001190 MAIN-SECTION.
001200     PERFORM INICIALIZAR
001210     PERFORM PROCESAR
001220     PERFORM FINALIZAR
001230     GOBACK.
001240*****************************************************************
001250 INICIALIZAR.
001260     OPEN INPUT  ARCH-INPUT
001270          OUTPUT ARCH-LIBROS
001280          OUTPUT ARCH-REP
001290*
001300     MOVE SPACES        TO REG-REP
001310     MOVE LINEA-CABECERA TO REG-REP
001320     WRITE REG-REP.
001330*****************************************************************
001340 PROCESAR.
001350     PERFORM LEER-REGISTRO
001360     PERFORM UNTIL FIN-ARCHIVO
001370        ADD 1 TO WS-LEIDOS
001380        PERFORM PARSEAR-REGISTRO
001390        PERFORM VALIDAR-REGISTRO
001400        IF VALID-OK
001410           PERFORM GRABAR-LIBRO
001420           PERFORM GRABAR-DETALLE-OK
001430        ELSE
001440           PERFORM GRABAR-DETALLE-ERROR
001450        END-IF
001460        PERFORM LEER-REGISTRO
001470     END-PERFORM.
001480*****************************************************************
001490 LEER-REGISTRO.
001500     READ ARCH-INPUT
001510         AT END
001520            MOVE 'S' TO WS-FIN
001530     END-READ.
001540*****************************************************************
001550 PARSEAR-REGISTRO.
001560* FORMATO DE ENTRADA (LRECL=200)
001570* 1-10   CODIGO
001580* 11-70  TITULO
001590* 71-110 AUTOR
001600* 111-140 EDITORIAL
001610* 141-160 CATEGORIA
001620* 161-163 STOCK
001630* 164-173 UBICACION
001640*****************************************************************
001650     MOVE REG-INPUT(1:10)    TO IN-CODIGO
001660     MOVE REG-INPUT(11:60)   TO IN-TITULO
001670     MOVE REG-INPUT(71:40)   TO IN-AUTOR
001680     MOVE REG-INPUT(111:30)  TO IN-EDITORIAL
001690     MOVE REG-INPUT(141:20)  TO IN-CATEGORIA
001700     MOVE REG-INPUT(161:3)   TO IN-STOCK
001710     MOVE REG-INPUT(164:10)  TO IN-UBICACION.
001720*****************************************************************
001730 VALIDAR-REGISTRO.
001740     SET VALID-OK TO TRUE
001750     MOVE 'N' TO WS-DUP-FLAG
001760*
001770* VALIDACION CODIGO OBLIGATORIO                                *
001780     IF FUNCTION TRIM(IN-CODIGO) = SPACES
001790        SET VALID-NOK TO TRUE
001800     END-IF
001810*
001820* VALIDACION TITULO OBLIGATORIO                                *
001830     IF FUNCTION TRIM(IN-TITULO) = SPACES
001840        SET VALID-NOK TO TRUE
001850     END-IF
001860*
001870* VALIDACION STOCK > 0                                         *
001880     IF IN-STOCK = ZERO
001890        SET VALID-NOK TO TRUE
001900     END-IF
001910*
001920* CONTROL DE CODIGO DUPLICADO (SOLO SI PASO VALIDACIONES      *
001930* BASICAS)                                                    *
001940     IF VALID-OK
001950        PERFORM BUSCAR-DUPLICADO
001960        IF CODIGO-DUPLICADO
001970           SET VALID-NOK TO TRUE
001980        END-IF
001990     END-IF.
002000*****************************************************************
002010 BUSCAR-DUPLICADO.
002020     MOVE 'N' TO WS-DUP-FLAG
002030     IF WS-COD-COUNT > 0
002040        PERFORM VARYING WS-INDEX FROM 1 BY 1
002050                UNTIL WS-INDEX > WS-COD-COUNT
002060                       OR CODIGO-DUPLICADO
002070           IF IN-CODIGO = WS-CODIGO-EXISTENTE(WS-INDEX)
002080              MOVE 'S' TO WS-DUP-FLAG
002090           END-IF
002100        END-PERFORM
002110     END-IF.
002120*****************************************************************
002130 GRABAR-LIBRO.
002140     MOVE IN-CODIGO       TO LIB-CODIGO
002150     MOVE IN-TITULO       TO LIB-TITULO
002160     MOVE IN-AUTOR        TO LIB-AUTOR
002170     MOVE IN-EDITORIAL    TO LIB-EDITORIAL
002180     MOVE IN-CATEGORIA    TO LIB-CATEGORIA
002190     MOVE IN-STOCK        TO LIB-STOCK-TOTAL
002200     MOVE IN-STOCK        TO LIB-STOCK-DISPONIBLE
002210     MOVE IN-UBICACION    TO LIB-UBICACION
002220*
002230     WRITE REG-LIBRO
002240     IF WS-STAT-LIBROS = "00"
002250        ADD 1 TO WS-OK
002260        ADD 1 TO WS-COD-COUNT
002270        MOVE IN-CODIGO
002280            TO WS-CODIGO-EXISTENTE(WS-COD-COUNT)
002290     ELSE
002300        ADD 1 TO WS-ERR
002310     END-IF.
002320*****************************************************************
002330 GRABAR-DETALLE-OK.
002340     MOVE SPACES        TO REG-REP
002350     MOVE IN-CODIGO     TO LIN-CODIGO
002360     MOVE IN-TITULO     TO LIN-TITULO
002370     MOVE "OK"          TO LIN-RESULTADO
002380     MOVE LINEA-DETALLE TO REG-REP
002390     WRITE REG-REP.
002400*****************************************************************
002410 GRABAR-DETALLE-ERROR.
002420     ADD 1 TO WS-ERR
002430     MOVE SPACES        TO REG-REP
002440     MOVE IN-CODIGO     TO LIN-CODIGO
002450     MOVE IN-TITULO     TO LIN-TITULO
002460     MOVE "ERROR"       TO LIN-RESULTADO
002470     MOVE LINEA-DETALLE TO REG-REP
002480     WRITE REG-REP.
002490*****************************************************************
002500 FINALIZAR.
002510     MOVE WS-LEIDOS TO WS-DISP-LEIDOS
002520     MOVE WS-OK     TO WS-DISP-OK
002530     MOVE WS-ERR    TO WS-DISP-ERR
002540*
002550     MOVE SPACES               TO REG-REP
002560     MOVE "TOTAL LEIDOS    : " TO REG-REP(1:19)
002570     MOVE WS-DISP-LEIDOS       TO REG-REP(21:7)
002580     WRITE REG-REP
002590*
002600     MOVE SPACES               TO REG-REP
002610     MOVE "TOTAL OK        : " TO REG-REP(1:19)
002620     MOVE WS-DISP-OK           TO REG-REP(21:7)
002630     WRITE REG-REP
002640*
002650     MOVE SPACES               TO REG-REP
002660     MOVE "TOTAL CON ERROR : " TO REG-REP(1:19)
002670     MOVE WS-DISP-ERR          TO REG-REP(21:7)
002680     WRITE REG-REP
002690*
002700     CLOSE ARCH-INPUT ARCH-LIBROS ARCH-REP.
